generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id        String   @id @default(cuid())
  clerkId   String   @unique
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders Order[]
}

model Category {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String
  status      String   @default("soon")
  price       Decimal? @db.Decimal(10, 2)
  stockCount  Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  qaEntries  QaEntry[]
  variants   ProductVariant[]
  orderItems OrderItem[]
}

model ProductVariant {
  id         String   @id @default(cuid())
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])
  label      String
  price      Decimal  @db.Decimal(10, 2)
  stockCount Int?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  orderItems OrderItem[]
}

model Order {
  id              String   @id @default(cuid())
  userId          String?
  user            User?    @relation(fields: [userId], references: [id])
  guestName       String?
  guestEmail      String?
  guestPhone      String?
  paymentMethod   String // "stripe" | "pickup"
  status          String   @default("pending") // "pending" | "paid" | "ready" | "completed" | "cancelled"
  stripeSessionId String?  @unique
  pickupNotes     String?
  total           Decimal  @db.Decimal(10, 2)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  items OrderItem[]
}

model OrderItem {
  id         String          @id @default(cuid())
  orderId    String
  order      Order           @relation(fields: [orderId], references: [id])
  categoryId String
  category   Category        @relation(fields: [categoryId], references: [id])
  variantId  String?
  variant    ProductVariant? @relation(fields: [variantId], references: [id])
  label      String
  price      Decimal         @db.Decimal(10, 2)
  quantity   Int
  createdAt  DateTime        @default(now())
}

model QaEntry {
  id          String   @id @default(cuid())
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id])
  date        DateTime @default(now())
  note        String
  eggsSet     Int?
  eggsHatched Int?
  chicksDied  Int?
  createdAt   DateTime @default(now())
}

model HatchCamSettings {
  id           String   @id @default(cuid())
  mode         String   @default("offline") // "offline" | "photo" | "live"
  photoUrl     String?
  liveEmbedUrl String?
  updatedAt    DateTime @updatedAt
}
